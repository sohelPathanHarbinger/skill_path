# Default settings. Copy this file to .env.local and fill in what you need. .env.local is git-ignored.
# Restart `npm run dev` after changing anything here.
# Anything chosen in the app's Settings popup overrides these defaults.

# Which AI to use by default:
#   anthropic (default) | gemini | groq | openrouter | mistral | cerebras | huggingface | cohere
#   openai | deepseek | xai | ollama | lmstudio | custom
VITE_AI_PROVIDER=anthropic

# Model for the default AI. Leave empty to use that AI's recommended model.
VITE_AI_MODEL=

# How much the model thinks per request, for AIs that support it (low = fewest tokens).
# Claude: low | medium | high | xhigh | max. Others vary; unsupported values are ignored.
VITE_AI_EFFORT=low

# API keys: fill in only the ones you use.
VITE_ANTHROPIC_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_MISTRAL_API_KEY=
VITE_CEREBRAS_API_KEY=
VITE_HUGGINGFACE_API_KEY=
VITE_COHERE_API_KEY=
VITE_OPENAI_API_KEY=
VITE_DEEPSEEK_API_KEY=
VITE_XAI_API_KEY=

# A custom OpenAI-compatible service (provider "custom"): the URL before /chat/completions.
VITE_CUSTOM_BASE_URL=
VITE_CUSTOM_API_KEY=
